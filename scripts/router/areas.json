    "kernel": {
      "title": "Ядро: запуск, перезапуск, переключение, watchdog, XKeen",
      "shared": true,
      "paths": [
        "internal/services/kernel*.go",
        "internal/services/watchdog.go",
        "internal/services/xkeen*.go",
        "internal/handlers/kernel*.go",
        "internal/handlers/watchdog.go",
        "internal/handlers/service.go",
        "internal/handlers/mihomo.go",
        "internal/handlers/xkeen*.go"
