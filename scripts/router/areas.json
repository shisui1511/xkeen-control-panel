      "canary": {
        "go": null,
        "spec": "tests/router/core-switch.spec.ts",
        "reason": "Go: тесты области с путём «Применить → ядро» размечены CoreSpecific, единственный без метки (TestRouterMihomoSwitchDraftOpen) длиннее 30 с — кандидат 148.1.1; спек core-switch идёт в каждой ветви ядра"
      }
    },
