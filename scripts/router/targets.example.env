# Образец локального файла целей проверки на роутерах.
#
# Настоящий файл лежит в основной копии репозитория по пути
#   scripts/router/targets.local.env
# (режим 600) и НЕ попадает в git: правило scripts/router/*.local.env есть в
# .gitignore и в общем info/exclude. Скрипты каталога находят его из любого
# worktree. Здесь только заглушки — реальные алиасы, адреса, пароли и URL
# подписки в отслеживаемые файлы писать нельзя.
#
# Другой файл можно указать переменной XCP_TARGETS_FILE.

# Цели через пробел. Идентификатор — строчные латинские буквы и цифры,
# нейтральная метка (в отчётах и сводке используется она, а не адрес).
XCP_TARGETS="arm64 mipsle"

# Для каждой цели <id>:
#   SSH       алиас из ~/.ssh/config (вход по ключу, без пароля)
#   ARCH      arm64 | mipsle | mips — архитектура сборки xcp
#   URL       адрес панели https://<адрес>:<порт>
#   PASSWORD  пароль панели
XCP_T_arm64_SSH=my-router-alias
XCP_T_arm64_ARCH=arm64
XCP_T_arm64_URL=https://192.0.2.1:8090
XCP_T_arm64_PASSWORD=change-me

XCP_T_mipsle_SSH=my-second-router-alias
XCP_T_mipsle_ARCH=mipsle
XCP_T_mipsle_URL=https://192.0.2.2:8090
XCP_T_mipsle_PASSWORD=change-me

# Порядок перезагрузки для SUITE=reboot: идентификаторы целей через пробел, нижестоящая
# цель каскада первой; перезагрузка вышестоящей обрывает связь ПК и upstream нижестоящей.
# Не задан — порядок XCP_TARGETS с предупреждением в отчёте, но по одной цели.
XCP_REBOOT_ORDER="mipsle arm64"

# Подписка, которая добавляется в панель на целях (одна на все цели).
XCP_SUBSCRIPTION_URL=https://example.invalid/sub

# Необязательно: дополнительные строки, которых не должно быть в git
# (check-leaks.sh), по одной на строку, например адрес ПК или путь домашнего каталога.
# XCP_LEAK_EXTRA='192.0.2.100
# /home/user'
