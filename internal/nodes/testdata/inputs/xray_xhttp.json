{
  "tag": "proxy",
  "protocol": "vless",
  "settings": {
    "vnext": [
      {
        "address": "node1.example",
        "port": 443,
        "users": [
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "encryption": "none",
            "flow": ""
          }
        ]
      }
    ]
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "tls",
    "tlsSettings": {
      "serverName": "cdn.example",
      "alpn": ["h2", "http/1.1"],
      "fingerprint": "chrome"
    },
    "xhttpSettings": {
      "path": "/xh",
      "host": "cdn.example",
      "mode": "stream-up",
      "xPaddingBytes": "100-1000",
      "noGRPCHeader": true,
      "xmux": {
        "maxConcurrency": "16-32",
        "maxConnections": "0"
      }
    }
  }
}
