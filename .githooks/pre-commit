#!/bin/sh
# .githooks/pre-commit — быстрые проверки форматирования перед коммитом.
# Подключение: make hooks (git config core.hooksPath .githooks).
#
# Проверяются только файлы из индекса:
#   frontend/** → prettier --check (те же правила, что в CI/Lint Frontend)
#   *.go        → gofmt -l
#   весь индекс → scripts/check-no-simulations.js (тесты вне роутера запрещены)
#   индекс целиком → scripts/router/check-leaks.sh --staged (строки локального
#                    файла целей; нет файла — пропуск)
# Пропустить разово: git commit --no-verify.

set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

FAILED=0

FRONT=$(printf '%s\n' "$STAGED" | sed -n 's#^frontend/##p')
if [ -n "$FRONT" ]; then
  if [ ! -x frontend/node_modules/.bin/prettier ]; then
    echo "pre-commit: нет frontend/node_modules — выполните cd frontend && npm ci" >&2
    exit 1
  fi
  if ! (cd frontend && printf '%s\n' "$FRONT" | xargs node_modules/.bin/prettier --check --ignore-unknown --log-level warn); then
    echo "pre-commit: исправьте форматирование: cd frontend && npx prettier --write ." >&2
    FAILED=1
  fi
fi

GO=$(printf '%s\n' "$STAGED" | grep '\.go$' || true)
if [ -n "$GO" ]; then
  UNFORMATTED=$(printf '%s\n' "$GO" | xargs gofmt -l)
  if [ -n "$UNFORMATTED" ]; then
    echo "pre-commit: файлы не отформатированы gofmt (make fmt):" >&2
    printf "%s\n" "$UNFORMATTED" | sed "s/^/  /" >&2
    FAILED=1
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: нужен node для проверки check-no-simulations.js" >&2
  exit 1
fi
if ! node scripts/check-no-simulations.js; then
  echo "pre-commit: тесты вне роутера запрещены (AGENTS.md, «Тестирование»)" >&2
  FAILED=1
fi

# Строки стенда из локального файла целей не должны попасть в индекс. В старых
# ветках скрипта может не быть — тогда блок пропускается. stdout (охват целей)
# скрыт, stderr с находками «файл:строка» остаётся видимым.
if [ -f scripts/router/check-leaks.sh ]; then
  if ! sh scripts/router/check-leaks.sh --staged >/dev/null; then
    echo "pre-commit: в коммит попадают строки из локального файла целей (D-40): уберите их или замените переменными" >&2
    FAILED=1
  fi
fi

exit "$FAILED"
